# Prefer the standard (non-SRV) form if mongodb+srv:// fails with a
# "querySrv ECONNREFUSED" DNS error on your machine/network:
# mongodb://<user>:<pass>@shard-00-00.cluster.mongodb.net:27017,shard-00-01.cluster.mongodb.net:27017,shard-00-02.cluster.mongodb.net:27017/?ssl=true&replicaSet=<name>&authSource=admin&retryWrites=true&w=majority
PORT=5000
MONGODB_URI=mongodb+srv://<user>:<pass>@cluster.mongodb.net/neorecipe
JWT_SECRET=replace_me_with_a_long_random_string
CLIENT_ORIGIN=http://localhost:5173
NODE_ENV=development
